{
  "name": "@lazy-armor/plan-schema",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./mobile": {
      "types": "./src/mobile.ts",
      "default": "./dist/mobile.js"
    },
    "./consumer": {
      "types": "./src/consumer-projection.ts",
      "default": "./dist/consumer-projection.js"
    },
    "./outcome": {
      "types": "./src/consumer-outcome.ts",
      "default": "./dist/consumer-outcome.js"
    },
    "./share": {
      "types": "./src/share-text-parser.ts",
      "default": "./dist/share-text-parser.js"
    },
    "./local-capabilities": {
      "types": "./src/local-capabilities.ts",
      "default": "./dist/local-capabilities.js"
    },
    "./service-offering": {
      "types": "./src/service-offering.ts",
      "default": "./dist/service-offering.js"
    },
    "./capability-identity": {
      "types": "./src/capability-identity.ts",
      "default": "./dist/capability-identity.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.1.5"
  },
  "devDependencies": {
    "vitest": "4.1.11"
  }
}
