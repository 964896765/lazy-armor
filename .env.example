NODE_ENV=development
APP_ENV=development
API_PORT=3001
DATABASE_URL=mysql://lazy_armor:lazy_armor_dev@127.0.0.1:3307/lazy_armor
REDIS_URL=redis://127.0.0.1:6379
# Required in staging/production: lazy-armor-staging or lazy-armor-production.
REDIS_KEY_PREFIX=
JWT_SECRET=replace-with-at-least-32-random-characters
# 32-byte key encoded as base64. Generate a different value per environment.
CREDENTIAL_MASTER_KEY=replace-with-a-base64-encoded-32-byte-key
CREDENTIAL_STORE_PATH=.data/credentials
# Expand 0093 first. LEGACY keeps old reads/writes; SHADOW compares and dual-writes;
# UNIFIED permits verified identifier aliases only after backfill audit is clean.
AUTH_PASSWORD_CREDENTIAL_MODE=LEGACY
# Expand 0097 before enabling Web Passkey.
AUTH_PASSKEY_ENABLED=false
# Set fixed HTTPS Web origins and matching RP hostname before enabling. Never infer from request headers.
# AUTH_PASSKEY_RP_ID=app.your-domain.example
# AUTH_PASSKEY_ORIGINS=https://app.your-domain.example
# New email binding requires UNIFIED and a usable email code provider.
AUTH_EMAIL_BIND_ENABLED=false
AUTH_PHONE_BIND_ENABLED=false
# Expand 0095 before deploying. Old phone tombstones cannot be read by pre-0095 auth code.
AUTH_PHONE_CHANGE_ENABLED=false
# Separate security templates; only the outbox-worker sends pending notices.
AUTH_SECURITY_NOTICE_SEND_ENABLED=false
AUTH_SECURITY_NOTICE_ENDPOINT=
AUTH_SECURITY_NOTICE_TOKEN=
AUTH_SECURITY_NOTICE_PHONE_TEMPLATE=
AUTH_SECURITY_NOTICE_EMAIL_TEMPLATE=
# Real SMS is independently disabled until 0094, gateway contract and delivery acceptance pass.
SMS_LOGIN_SEND_ENABLED=false
# 0096 first. Client hints never prove account/device ownership; SQL risk caps persist.
AUTH_SMS_ABUSE_GUARD_ENABLED=false
AUTH_SMS_ABUSE_SECRET=
AUTH_SMS_CLIENT_SEND_LIMIT=5
AUTH_SMS_CLIENT_PHONE_LIMIT=3
AUTH_SMS_IP_PHONE_LIMIT=5
AUTH_SMS_CLIENT_IP_LIMIT=2
AUTH_SMS_CLIENT_AGENT_LIMIT=2
AUTH_SMS_RISK_DAILY_REQUEST_LIMIT=500
AUTH_SMS_RISK_RETENTION_DAYS=7
# Keep cleanup true after disabling protection when restarting an existing 0096 environment.
AUTH_SMS_RISK_CLEANUP_ENABLED=false
SMS_LOGIN_DELIVERY_ENDPOINT=
LOGIN_CODE_DELIVERY_TOKEN=
SMS_LOGIN_TEMPLATE_ID=
# Stable independent secret; changing it resets per-number/IP pseudonyms.
SMS_LOGIN_QUOTA_SECRET=
SMS_LOGIN_PHONE_DAILY_LIMIT=5
SMS_LOGIN_IP_DAILY_LIMIT=20
SMS_LOGIN_GLOBAL_DAILY_LIMIT=100
SMS_LOGIN_MAX_UNIT_COST_FEN=10
SMS_LOGIN_DAILY_BUDGET_FEN=1000
# BOUND enables recovery through verified email aliases; requires UNIFIED.
AUTH_PASSWORD_RECOVERY_MODE=LEGACY
# Suspend new email delivery while retaining bound token validation.
AUTH_PASSWORD_RECOVERY_REQUEST_ENABLED=true
EXPO_PUBLIC_API_URL=http://127.0.0.1:3001
EXPO_PUBLIC_APP_ENV=development
# Admin BFF: existing administrator accounts sign in; tokens stay in HttpOnly cookies.
# Exact browser origin required in production; public deployments must use HTTPS.
ADMIN_API_URL=http://127.0.0.1:3001
ADMIN_PUBLIC_ORIGIN=http://127.0.0.1:3002
# P5-C remains opt-in sandbox only. Production validation requires disabled.
SUBSCRIPTION_BILLING_PROVIDER=disabled
SUBSCRIPTION_BILLING_SANDBOX_WEBHOOK_SECRET=replace-with-at-least-32-characters
WEBHOOK_RETENTION_DAYS=7
WEBHOOK_CLEANUP_INTERVAL_SECONDS=3600
WORKER_READINESS_TIMEOUT_MS=3000
# All empty disables Gmail; partial configuration fails closed. Never commit real secrets.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
# Exact HTTPS backend path: /api/providers/google/oauth/gmail/callback
GMAIL_OAUTH_REDIRECT_URI=
# Same Google client credentials, separately registered Calendar backend HTTPS callback.
GOOGLE_CALENDAR_OAUTH_REDIRECT_URI=
# GitHub integration foundation only; setting these does not yet enable its adapter.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=
GITHUB_WEBHOOK_SECRET=
# Only explicitly trusted TLS-terminating proxies may supply X-Forwarded-Proto.
TRUSTED_PROXY_CIDRS=

# Android release signing (never commit real values). Production release builds fail closed when absent.
LAZY_ARMOR_ANDROID_KEYSTORE=
LAZY_ARMOR_ANDROID_KEYSTORE_PASSWORD=
LAZY_ARMOR_ANDROID_KEY_ALIAS=
LAZY_ARMOR_ANDROID_KEY_PASSWORD=
# Local artifact verification only; never set this in production CI.
LAZY_ARMOR_ANDROID_ALLOW_DEBUG_RELEASE=false
WORKER_PROBE_HOST=127.0.0.1
EXECUTION_WORKER_PROBE_PORT=3011
OUTBOX_WORKER_PROBE_PORT=3012

# Private development AI only; never returned to the mobile client.
DEEPSEEK_SERVER_DEV_ENABLED=0
AGENT_MODEL_PROVIDER=deepseek
AGENT_MODEL_BASE_URL=https://api.deepseek.com
AGENT_MODEL_NAME=deepseek-flash
AGENT_MODEL_API_KEY=
# Operator-reviewed, schema-pinned MCP execution bindings; absent means unavailable.
# Each binding must declare a write tool, independent read-back tool and comparisons.
MCP_EXECUTION_BINDINGS_JSON=
