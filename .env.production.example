NODE_ENV=production
APP_ENV=production
API_PORT=3001
DATABASE_URL=mysql://lazy_armor_production:use-secret-manager@production-db.internal:3306/lazy_armor_production
REDIS_URL=rediss://production-redis.internal:6379/0
REDIS_KEY_PREFIX=lazy-armor-production
JWT_SECRET=inject-a-unique-production-secret-of-at-least-32-characters
CREDENTIAL_MASTER_KEY=inject-a-unique-base64-encoded-32-byte-production-key
CREDENTIAL_PROVIDER=production
ALLOWED_ORIGINS=https://app.lazyarmor.example
PUBLIC_REGISTRATION=false
EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_API_URL=https://api.lazyarmor.example

