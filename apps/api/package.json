    "@lazy-armor/shared": "workspace:*",
    "@nestjs/common": "11.1.18",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.18",
    "@nestjs/jwt": "11.0.1",
    "@nestjs/platform-express": "11.1.18",
    "bcryptjs": "3.0.2",
    "bullmq": "6.3.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "ioredis": "5.8.1",
    "mysql2": "3.24.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
