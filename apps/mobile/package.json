{
  "name": "@lazy-armor/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "build": "expo export --platform web",
    "android:prebuild": "expo prebuild --platform android --no-install",
    "android:release": "cd android && gradlew.bat assembleRelease",
    "dev": "expo start",
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.14",
    "@tanstack/react-query": "5.102.8",
    "expo": "57.0.18",
    "expo-constants": "~57.0.16",
    "expo-linking": "57.0.8",
    "expo-router": "57.0.17",
    "expo-secure-store": "^57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.3",
    "@types/react": "~19.2.4",
    "vitest": "4.1.11"
