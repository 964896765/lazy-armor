{
  "name": "lazy-armor",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --parallel",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "migration:safety": "node scripts/check-migration-safety.mjs && node scripts/check-drizzle-migration-segments.mjs",
    "repository:hygiene": "node scripts/check-repository-hygiene.mjs",
    "data:truth": "node scripts/check-production-data-truth.mjs",
    "audit:dependencies": "pnpm audit --prod --audit-level=high",
    "db:migrate": "pnpm --filter @lazy-armor/database migrate",
    "db:backup-restore-gate": "pnpm --filter @lazy-armor/database backup-restore-gate",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml down"
  },
  "devDependencies": {
    "@types/node": "22.18.1",
    "turbo": "2.5.6",
    "typescript": "5.9.2"
  },
  "pnpm": {
    "overrides": {
      "decode-uri-component": "0.5.0",
      "lodash": "4.18.0",
      "multer": "2.2.0",
      "path-to-regexp": "8.4.2",
      "uuid": "11.1.1"
    }
  }
}
