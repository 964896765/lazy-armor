NODE_ENV=production
APP_ENV=staging
API_PORT=3001
DATABASE_URL=mysql://lazy_armor_staging:use-secret-manager@staging-db.internal:3306/lazy_armor_staging
REDIS_URL=rediss://staging-redis.internal:6379/0
REDIS_KEY_PREFIX=lazy-armor-staging
JWT_SECRET=inject-a-unique-staging-secret-of-at-least-32-characters
CREDENTIAL_MASTER_KEY=inject-a-unique-base64-encoded-32-byte-staging-key
CREDENTIAL_PROVIDER=production
ALLOWED_ORIGINS=https://staging.lazyarmor.example
PUBLIC_REGISTRATION=false
EXPO_PUBLIC_APP_ENV=staging
EXPO_PUBLIC_API_URL=https://staging-api.lazyarmor.example

