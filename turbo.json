{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "MYSQL_ADMIN_URL",
    "REDIS_URL",
    "JWT_SECRET",
    "CREDENTIAL_MASTER_KEY",
    "APP_ENV",
    "NODE_ENV",
    "APP_ROLE",
    "EXPO_PUBLIC_APP_ENV",
    "RUN_REAL_DB_INTEGRATION"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["build", "^build"]
    }
  }
}
